# Copy to .env next to compose.yaml. Values here are examples.

# PostgreSQL password of the "sms" role. It is embedded in the database URL:
# avoid characters that need URL encoding (@ : / ? # %).
POSTGRES_PASSWORD=change-me

# "tplink" (the device) or "mock" (no hardware, enables /v1/dev/* routes).
MODEM_KIND=tplink
# Device web UI address, as reached from the container.
MODEM_URL=http://192.168.254.1
MODEM_PASSWORD=change-me
# IANA time zone of the device clock.
MODEM_TIMEZONE=Europe/Paris

# Published address of the API. Use 0.0.0.0 to expose it on the network.
SMS_GATEWAY_BIND=127.0.0.1
SMS_GATEWAY_PORT=8080

# "text" or "json".
LOG_FORMAT=text

# Image to run (or to tag when building with `docker compose build`).
# SMS_GATEWAY_IMAGE=ghcr.io/alcelafranque/sms-api-gateway:latest
